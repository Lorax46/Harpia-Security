# AWS
AWS_PROFILE=default
AWS_REGION=us-east-1

# GCP
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# OCI
OCI_TENANCY=
OCI_USER=
OCI_FINGERPRINT=
OCI_KEY_FILE=~/.oci/oci_api_key.pem

# Prowler
PROWLER_VERSION=5.2.0
PROWLER_OUTPUT_DIR=./output

# API
API_PORT=8080
LOG_LEVEL=info

# Database (futuro)
DATABASE_URL=postgres://harpia:harpia@localhost:5432/harpia?sslmode=disable
