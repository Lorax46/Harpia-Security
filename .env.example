# Exemplo de configuração para teste local
# Copie para .env e preencha com suas credenciais AWS

# Credenciais AWS (deixe vazio para usar ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Configuração do servidor
HORUS_ADDR=:8080
HORUS_JWT_SECRET=change-this-in-production

# Provider: aws, gcp, azure, oci
HORUS_PROVIDER=aws
