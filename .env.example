# TOTVS Horus Configuration

# Application
APP_ENV=development
APP_VERSION=2.0.0-beta

# Gateway
GATEWAY_PORT=8080
JWT_SECRET=change-me-in-production-use-random-string
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=100

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=horus
DB_PASSWORD=horus
DB_NAME=horus
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=horus

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=horus
MINIO_PASSWORD=horus12345

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9009
CLICKHOUSE_USER=horus
CLICKHOUSE_PASSWORD=horus
CLICKHOUSE_DB=horus

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=horus
RABBITMQ_PASSWORD=horus

# Frontend
FRONTEND_PORT=3000
API_URL=http://localhost:8080
NODE_ENV=development

# Integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SHODAN_API_KEY=
SLACK_WEBHOOK_URL=
PAGERDUTY_KEY=
VIRUSTOTAL_API_KEY=

# Scan Configuration
SCAN_TIMEOUT_MINUTES=60
MAX_CONCURRENT_SCANS=5
DATA_RETENTION_DAYS=90
ENABLE_AUTO_REMEDIATION=false
ENABLE_EPSS_SCORING=true
ENABLE_KEV_DETECTION=true
